# Salin file ini menjadi .env lalu isi nilainya.

# Port server (default 3001)
PORT=3001

# URL publik website Anda (dipakai untuk link kembali dari halaman pembayaran)
PUBLIC_URL=http://localhost:5173

# Password halaman admin (/admin). WAJIB diganti.
ADMIN_PASSWORD=ganti-password-ini

# --- Midtrans (opsional) ---
# Kosongkan untuk mode "transfer manual" (Anda konfirmasi pembayaran sendiri di /admin).
# Ambil key di dashboard.midtrans.com -> Settings -> Access Keys
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# true = transaksi asli, false = sandbox (uji coba)
MIDTRANS_IS_PRODUCTION=false

# Lokasi penyimpanan database & gambar pesanan (default ./data)
DATA_DIR=./data
